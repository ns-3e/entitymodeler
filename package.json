{
  "name": "entitymodeler",
  "version": "0.1.3",
  "license": "MIT",
  "homepage": "https://entitymodel.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ns-3e/entitymodeler.git"
  },
  "type": "module",
  "description": "EntityModel.com: an open-source, browser-based entity-relationship modeling tool with ERD diagrams, PDF and design-doc table exports, and a CLI.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181",
    "build:cli": "esbuild cli/em.ts --bundle --platform=node --format=esm --target=node18 --external:html2canvas --external:canvg --external:dompurify --outfile=bin/em.mjs --banner:js=\"// Generated by npm run build:cli - do not edit. Source: cli/em.ts\"",
    "em": "node bin/em.mjs",
    "publish-npm": "node scripts/publish-npm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/uninstall-service.sh",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.entitymodeler.app",
    "service:logs": "tail -f ~/Library/Logs/EntityModeler/*.log",
    "skills:package": "mkdir -p cowork-skills && find cowork-skills -name '*.zip' -delete && cd .claude/skills && for d in */; do zip -qr \"../../cowork-skills/${d%/}.zip\" \"${d%/}\"; done && echo 'Skill zips in cowork-skills/'",
    "screenshots": "node scripts/screenshots.mjs",
    "ui-audit": "node scripts/ui-audit.mjs",
    "og-images": "node scripts/og-images.mjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/em-bench.mjs && node node_modules/.cache/em-bench.mjs",
    "agent-eval": "node scripts/agent-eval.mjs",
    "publish-snapshot": "node scripts/publish-snapshot.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@xyflow/react": "^12.3.6",
    "html-to-image": "^1.11.11",
    "immer": "^10.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "marked": "^18.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
